# URL base de la API (incluye /api/v1)
#
# iOS simulador / web:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# Android emulador:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# Dispositivo físico (misma Wi‑Fi que el PC):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
#
# Dispositivo fuera de la Wi‑Fi del PC (API desplegada):
# EXPO_PUBLIC_API_URL=https://dev-epoint-crm-backend-3807e7e86dca.herokuapp.com/api/v1
#
# Si no se define, la app elige localhost (iOS) o 10.0.2.2 (Android).

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
